# Deployment env for docker-compose.yml. Copy to .env (gitignored) and fill in.
# Resolve into the stack with: docker stack deploy -c <(docker compose config) centia-agent

# Hostname of the host app; Traefik routes <AGENT_HOST>/agent/* to this stack.
AGENT_HOST=app.example.com

# LLM provider: bedrock (default) | anthropic | openai
LLM_PROVIDER=bedrock

# bedrock (Mantle endpoint in this region; model ids use the anthropic. prefix)
AWS_REGION=eu-west-1
BEDROCK_MODEL=anthropic.claude-sonnet-5
# One of: a Bedrock API key ...
AWS_BEARER_TOKEN_BEDROCK=
# ... or SigV4 credentials (leave both empty on an instance/task role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# anthropic (alternative to bedrock)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Centia API the MCP server talks to
API_BASE_URL=https://api.centia.io
